#!/bin/bash
# c2c - single front end for the usbc-c2c link and the stuff on top of it.
#
#   c2c status                 link, raw channels, services, what the peer lends us
#   c2c doctor                 sanity checks: cable roles, clocks, USB power states, services
#   c2c config [show]          settings from /etc/c2c/c2c.conf (+ defaults)
#   c2c config get KEY
#   c2c config set KEY VALUE [--apply]   checked first; --apply restarts whatever uses it
#   c2c gpu run CMD...         run a normal CUDA program; device 1 is the peer's GPU
#   c2c gpu ls                 which GPUs a program will see
#   c2c gpu bench [args]       bandwidth (each way + both at once) and latency
#   c2c gpu system on|off      master: all CUDA programs get the peer's GPU, no wrapper
#   c2c ram attach|detach|status   use the peer's RAM as swap here (master)
#   c2c cpu setup              master: one-time ssh key setup for CPU offload
#   c2c cpu run CMD...         run CMD on the peer (stdin/stdout go over the link)
#   c2c cpu pipe [-j N] [-o PATTERN] 'FILTER' FILES...
#                              push every FILE through FILTER (stdin -> stdout) using the
#                              cores of both boards; output goes to PATTERN ({} = file, default {}.out)
#   c2c bench link             link latency/traffic + a quick remote GPU bench
#   c2c setup                  the setup wizard (same thing as ./setup.sh)
#   c2c version
set -uo pipefail

CONF=/etc/c2c/c2c.conf
PREFIX=/opt/c2c
BIN=$PREFIX/bin
SRC=$PREFIX/src

c_ok()   { echo -e "  \033[1;32mok\033[0m    $*"; }
c_warn() { echo -e "  \033[1;33mwarn\033[0m  $*"; WARNS=$((WARNS + 1)); }
c_bad()  { echo -e "  \033[1;31mFAIL\033[0m  $*"; FAILS=$((FAILS + 1)); }
die()    { echo "c2c: $*" >&2; exit 1; }
need_root() { [ "$(id -u)" = 0 ] || die "this needs root: sudo c2c $*"; }

# ---------------------------------------------------------------- settings
# key|default|scope|values|description   scope = both / master / slave
KEYS='
role||both|master,slave|this node'"'"'s role (set by setup)
name||both|text|node name shown to the peer (default: hostname)
master_ip|10.77.0.1|both|ip|link address of the master
slave_ip|10.77.0.2|both|ip|link address of the slave
mtu|65000|both|int:1280:65535|link MTU (c2c0)
busy_poll_us|200|both|int:0:100000|c2cd: busy-poll this long after traffic (lower latency)
gadget_mode|exclusive|slave|exclusive,composite|USB gadget: exclusive (full speed) or composite (keeps NVIDIA RNDIS etc.)
raw_channels|4|slave|int:0:7|raw USB data channels (/dev/c2cchN) next to the link; 0 = TCP only
gpu_transport|auto|both|auto,raw,tcp|remote GPU data path: raw USB channel (fastest), TCP (survives cable cuts), auto = raw, else TCP
gpu_spin_us|1000|master|int:0:100000|remote GPU client: busy-poll for replies this long before sleeping
gpud_spin_us|1000|slave|int:0:100000|GPU server: busy-poll for requests this long before sleeping
gpud_download_buffer_mib|512|slave|int:64:4096|GPU server: page-locked buffering per session for downloads in flight
gpud_keep_power_gating|no|slave|yes,no|leave GPU power gating on while serving (saves power, +250 us per sync)
gpu_system_wide|no|master|yes,no|every CUDA program sees the peer'"'"'s GPU, without c2c gpu run
rmem_lend_gib|0|slave|int:0:4096|RAM this node lends to the master at boot (GiB, 0 = off)
rmem_auto|no|master|yes,no|attach the peer'"'"'s lent RAM as swap at boot
rmem_page_cluster|7|master|int:0:10|swap read-ahead 2^N pages per fault while remote RAM is attached
clocks_at_boot|yes|both|yes,no|pin CPU/GPU/EMC clocks at boot (jetson_clocks); needed for low latency
cpu_offload_user||master|text|login on the peer used by c2c cpu (default: your user name)
'

conf_raw() {   # whatever the file says (may be empty)
    [ -r "$CONF" ] || return 0
    sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\\([^#]*\\).*/\\1/p" "$CONF" | tail -n1 | sed 's/[[:space:]]*$//'
}
key_line()  { echo "$KEYS" | grep "^$1|"; }
key_field() { key_line "$1" | cut -d'|' -f"$2"; }
conf() {       # file value, else default
    local v; v="$(conf_raw "$1")"
    [ -n "$v" ] && { echo "$v"; return; }
    key_field "$1" 2
}
role() { conf role; }

validate() {   # key value
    local spec; spec="$(key_field "$1" 4)"
    case "$spec" in
        text) [ -n "$2" ] ;;
        ip)   [[ "$2" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] ;;
        int:*) local lo hi; lo="$(echo "$spec" | cut -d: -f2)"; hi="$(echo "$spec" | cut -d: -f3)"
               [[ "$2" =~ ^[0-9]+$ ]] && [ "$2" -ge "$lo" ] && [ "$2" -le "$hi" ] ;;
        *)    echo ",$spec," | grep -q ",$2," ;;
    esac
}

conf_set() {   # key value: replace in place or append, comments stay
    need_root config set
    if grep -q "^[[:space:]]*$1[[:space:]]*=" "$CONF" 2>/dev/null; then
        sed -i "s|^[[:space:]]*$1[[:space:]]*=.*|$1=$2|" "$CONF"
    else
        echo "$1=$2" >> "$CONF"
    fi
}

apply_key() {  # restart whoever reads this key
    local r; r="$(role)"
    case "$1" in
        raw_channels|gadget_mode)
            [ "$r" = slave ] && { systemctl stop c2c-gpud c2cd 2>/dev/null; systemctl restart c2c-gadget; systemctl start c2cd c2c-gpud 2>/dev/null; } ;;
        mtu|busy_poll_us|master_ip|slave_ip|name) systemctl restart c2cd; [ "$r" = slave ] && systemctl restart c2c-gpud 2>/dev/null ;;
        gpu_transport|gpud_*) [ "$r" = slave ] && systemctl restart c2c-gpud 2>/dev/null ;;
        gpu_system_wide) [ "$r" = master ] && gpu_system "$(conf gpu_system_wide)" ;;
        rmem_lend_gib) [ "$r" = slave ] && { if [ "$(conf rmem_lend_gib)" -gt 0 ]; then systemctl enable --now c2c-memd 2>/dev/null; systemctl restart c2c-memd; else systemctl disable --now c2c-memd 2>/dev/null; fi; } ;;
        rmem_auto) [ "$r" = master ] && { if [ "$(conf rmem_auto)" = yes ]; then systemctl enable --now c2c-rmem 2>/dev/null; else systemctl disable --now c2c-rmem 2>/dev/null; fi; } ;;
        clocks_at_boot) if [ "$(conf clocks_at_boot)" = yes ]; then systemctl enable --now c2c-clocks 2>/dev/null; else systemctl disable c2c-clocks 2>/dev/null; fi ;;
        *) ;;  # picked up next time it's used
    esac
}

cmd_config() {
    local sub="${1:-show}"; shift || true
    case "$sub" in
        show)
            printf "%-26s %-12s %s\n" KEY VALUE DESCRIPTION
            echo "$KEYS" | sed '/^$/d' | while IFS='|' read -r k def scope vals desc; do
                local r v mark=""; r="$(role)"
                [ "$scope" != both ] && [ -n "$r" ] && [ "$scope" != "$r" ] && continue
                v="$(conf "$k")"; [ -z "$(conf_raw "$k")" ] && mark=" (default)"
                printf "%-26s %-12s %s%s\n" "$k" "${v:--}" "$desc" "$mark"
            done ;;
        get) [ $# -ge 1 ] || die "usage: c2c config get KEY"; key_line "$1" >/dev/null || die "unknown key $1"; conf "$1" ;;
        set)
            [ $# -ge 2 ] || die "usage: c2c config set KEY VALUE [--apply]"
            key_line "$1" >/dev/null || die "unknown key '$1' (c2c config show lists them)"
            validate "$1" "$2" || die "invalid value '$2' for $1 (allowed: $(key_field "$1" 4))"
            conf_set "$1" "$2"; echo "$1=$2"
            if [ "${3:-}" = --apply ]; then apply_key "$1"; echo "applied"; else echo "(takes effect after: sudo c2c config set $1 $2 --apply, or a reboot)"; fi ;;
        *) die "usage: c2c config [show|get KEY|set KEY VALUE [--apply]]" ;;
    esac
}

# ---------------------------------------------------------------- status
cmd_status() {
    local r; r="$(role)"
    [ -n "$r" ] || die "C2C is not installed on this node (run ./setup.sh)"
    "$BIN/c2cctl" status 2>/dev/null | head -9 || echo "c2cd not running"
    echo
    echo "RAW CHANNELS (TCP-free data path)"
    local n=0 c
    for c in /dev/c2cch*; do [ -e "$c" ] && n=$((n + 1)); done
    if [ "$n" = 0 ]; then echo "  none (raw_channels=$(conf raw_channels); link down or TCP-only)"
    else
        for c in /dev/c2cch*; do
            local who; who="$(fuser "$c" 2>/dev/null | xargs -r ps -o comm= -p 2>/dev/null | sort -u | tr '\n' ' ')"
            echo "  $c  ${who:-free}"
        done
    fi
    echo
    echo "SERVICES"
    local u
    for u in c2cd c2c-gadget c2c-gpud c2c-memd c2c-rmem c2c-clocks; do
        systemctl list-unit-files "$u.service" >/dev/null 2>&1 || continue
        [ -e "/etc/systemd/system/$u.service" ] || continue
        printf "  %-12s %s (%s)\n" "$u" "$(systemctl is-active $u 2>/dev/null)" "$(systemctl is-enabled $u 2>/dev/null)"
    done
    echo
    echo "REMOTE RESOURCES"
    if [ "$r" = master ]; then
        echo "  GPU : $( [ -x $BIN/c2c-gpu-ls ] && LD_LIBRARY_PATH=$PREFIX/lib/cuda C2C_GPU_CONNECT_MS=800 timeout 10 $BIN/c2c-gpu-ls 2>/dev/null | grep -i c2c | head -1 || echo 'remote GPU support not installed')"
        echo "        transport $(conf gpu_transport), system-wide $(conf gpu_system_wide)"
        echo "  RAM : $("$BIN/c2c-rmem" status 2>/dev/null | head -1)"
    else
        echo "  lending GPU: $(systemctl is-active c2c-gpud 2>/dev/null), RAM: $( [ "$(conf rmem_lend_gib)" -gt 0 ] && echo "$(conf rmem_lend_gib) GiB" || echo off)"
    fi
}

cmd_doctor() {
    WARNS=0; FAILS=0
    local r; r="$(role)"
    echo "c2c doctor ($(hostname), role ${r:-not installed})"
    [ -f /etc/nv_tegra_release ] && c_ok "$(head -1 /etc/nv_tegra_release | sed 's/^# //; s/, GCID.*//')" || c_warn "not a Jetson?"
    grep -q "2888" /proc/device-tree/chosen/ids 2>/dev/null && c_ok "board: $(tr '\0' ' ' < /proc/device-tree/chosen/ids | awk '{print $1}') (AGX Xavier module)" || c_warn "not an AGX Xavier module (P2888): untested"
    [ -n "$r" ] || { c_bad "C2C not installed (./setup.sh)"; return 1; }
    # USB roles (decided by the cable)
    local dr; dr="$(cat /sys/class/typec/port0/data_role 2>/dev/null | grep -o '\[[a-z]*\]' | tr -d '[]')"
    if [ "$r" = master ]; then
        [ "$dr" = host ] && c_ok "USB-C: this node is the USB host" || c_bad "USB-C: this node is USB '$dr' but the master must be the host: replug/flip the cable at the slave end"
    else
        [ "$dr" = device ] && c_ok "USB-C: this node is the USB device" || c_bad "USB-C: this node is USB '$dr' but the slave must be the device: replug/flip the cable at the slave end"
    fi
    # link
    if grep -q '"state":"UP"' /run/c2c/status.json 2>/dev/null; then c_ok "link UP ($(grep -o '"peer":"[^"]*"' /run/c2c/status.json | cut -d'"' -f4))"
    else c_bad "link DOWN (journalctl -u c2cd)"; fi
    local nch=0 c; for c in /dev/c2cch*; do [ -e "$c" ] && nch=$((nch + 1)); done
    [ "$nch" -gt 0 ] && c_ok "$nch raw channels" || c_warn "no raw channels (raw_channels=$(conf raw_channels)): remote GPU uses TCP"
    if [ "$r" = master ]; then
        local d; for d in /sys/bus/usb/devices/*; do [ "$(cat $d/idVendor 2>/dev/null)" = 1209 ] || continue
            [ "$(cat $d/speed)" = 5000 ] && c_ok "SuperSpeed (5 Gbit/s)" || c_bad "link at $(cat $d/speed) Mbit/s (expected 5000): replug"
            [ "$(cat $d/power/usb3_hardware_lpm_u1 2>/dev/null)" != enabled ] && c_ok "USB3 U1/U2 off" || c_warn "USB3 U1/U2 enabled: +0.5 ms latency"
        done
        lsmod | grep -q '^c2c_kfix ' && c_ok "c2c_kfix loaded (remote RAM swap safe)" || c_warn "c2c_kfix not loaded: remote RAM disabled"
    fi
    # clocks
    local g=/sys/devices/system/cpu/cpu0
    if [ "$(cat $g/cpufreq/scaling_cur_freq)" = "$(cat $g/cpufreq/cpuinfo_max_freq)" ] && [ "$(cat $g/cpuidle/state1/disable 2>/dev/null)" = 1 ]; then
        c_ok "CPU clocks pinned at max, idle states off"
    else c_warn "CPU clocks not pinned (c2c config set clocks_at_boot yes --apply): ~2x higher latency"; fi
    if [ "$r" = slave ]; then
        systemctl is-active --quiet c2c-gpud && c_ok "GPU server running" || c_warn "GPU server not running"
    fi
    echo "  -- $FAILS failure(s), $WARNS warning(s)"
    [ "$FAILS" = 0 ]
}

# ---------------------------------------------------------------- GPU
LIBDIR=$PREFIX/lib/cuda
gpu_system() {   # on|off|yes|no
    need_root gpu system
    [ "$(role)" = master ] || die "system-wide GPU is a master setting"
    case "$1" in
        on|yes)
            [ -e "$LIBDIR/libcuda.so.1" ] || die "remote GPU support not installed"
            # ld.so.conf.d goes in name order, so 00-* beats nvidia-tegra.conf
            echo "$LIBDIR" > /etc/ld.so.conf.d/00-c2c-gpu.conf; ldconfig
            conf_set gpu_system_wide yes
            echo "every CUDA program now sees the peer's GPU as the last device (no wrapper needed)" ;;
        off|no)
            rm -f /etc/ld.so.conf.d/00-c2c-gpu.conf; ldconfig
            conf_set gpu_system_wide no
            echo "system-wide remote GPU off (c2c gpu run still works)" ;;
        *) die "usage: c2c gpu system on|off" ;;
    esac
}
cmd_gpu() {
    local sub="${1:-}"; shift || true
    case "$sub" in
        run) [ $# -gt 0 ] || die "usage: c2c gpu run CMD..."; export LD_LIBRARY_PATH="$LIBDIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"; exec "$@" ;;
        ls)  export LD_LIBRARY_PATH="$LIBDIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"; exec "$BIN/c2c-gpu-ls" ;;
        bench) export LD_LIBRARY_PATH="$LIBDIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"; exec "$BIN/c2c-gpu-bench" "$@" ;;
        system) gpu_system "${1:-}" ;;
        *) die "usage: c2c gpu run|ls|bench|system" ;;
    esac
}

# ---------------------------------------------------------------- RAM
cmd_ram() {
    local sub="${1:-status}"; shift || true
    case "$sub" in
        attach) need_root ram attach; exec "$BIN/c2c-rmem" attach -s "$(conf slave_ip)" -c 2 -w 100 -r "$(conf rmem_page_cluster)" "$@" ;;
        detach) need_root ram detach; exec "$BIN/c2c-rmem" detach "$@" ;;
        status) exec "$BIN/c2c-rmem" status "$@" ;;
        *) die "usage: c2c ram attach|detach|status" ;;
    esac
}

# ---------------------------------------------------------------- CPU
KEYF="$HOME/.ssh/c2c_offload_ed25519"
peer_user() { local u; u="$(conf cpu_offload_user)"; echo "${u:-$(id -un)}"; }
peer_ssh() { ssh -i "$KEYF" -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=accept-new "$(peer_user)@$(conf slave_ip)" "$@"; }
cmd_cpu() {
    local sub="${1:-}"; shift || true
    [ "$(role)" = master ] || die "CPU offload runs from the master"
    case "$sub" in
        setup)
            mkdir -p "$HOME/.ssh"; chmod 700 "$HOME/.ssh"
            [ -f "$KEYF" ] || ssh-keygen -q -t ed25519 -N '' -C "c2c-offload@$(hostname)" -f "$KEYF"
            echo "installing the offload key for $(peer_user)@$(conf slave_ip) (asks the peer's password once)"
            local line; line="from=\"$(conf master_ip)\" $(cat "$KEYF.pub")"
            ssh -o StrictHostKeyChecking=accept-new "$(peer_user)@$(conf slave_ip)" \
                "umask 077; mkdir -p ~/.ssh; grep -qF '$(cut -d' ' -f2 "$KEYF.pub")' ~/.ssh/authorized_keys 2>/dev/null || echo '$line' >> ~/.ssh/authorized_keys" \
                && echo "done: c2c cpu run / c2c cpu pipe can use $(peer_ssh nproc 2>/dev/null || echo '?') remote cores" ;;
        run)
            [ $# -gt 0 ] || die "usage: c2c cpu run CMD..."
            [ -f "$KEYF" ] || die "run 'c2c cpu setup' once first"
            peer_ssh "$@" ;;
        pipe) cpu_pipe "$@" ;;
        *) die "usage: c2c cpu setup|run CMD...|pipe [-j N] [-o PATTERN] 'FILTER' FILES..." ;;
    esac
}
# simple work queue over local+remote cores, one job = FILE -> FILTER -> output file
cpu_pipe() {
    local jl rl out='{}.out'
    while [ $# -gt 0 ]; do case "$1" in -j) jl="$2"; shift 2 ;; -o) out="$2"; shift 2 ;; *) break ;; esac; done
    [ $# -ge 2 ] || die "usage: c2c cpu pipe [-j LOCAL_JOBS] [-o PATTERN] 'FILTER' FILES..."
    [ -f "$KEYF" ] || die "run 'c2c cpu setup' once first"
    local filt="$1"; shift
    jl="${jl:-$(nproc)}"; rl="$(peer_ssh nproc 2>/dev/null || echo 0)"
    local q; q="$(mktemp -d)"; printf '%s\n' "$@" > "$q/list"; echo 0 > "$q/next"
    take() { ( flock 9; local n; n=$(cat "$q/next"); local f; f="$(sed -n "$((n + 1))p" "$q/list")"; [ -n "$f" ] || exit 1; echo $((n + 1)) > "$q/next"; echo "$f" ) 9>"$q/lock"; }
    worker() { local f o; while f="$(take)"; do o="${out//\{\}/$f}"
        if [ "$1" = local ]; then bash -c "$filt" < "$f" > "$o" || echo "c2c cpu: $f failed (local)" >&2
        else peer_ssh "$filt" < "$f" > "$o" || echo "c2c cpu: $f failed (remote)" >&2; fi
        echo "$1" >> "$q/done"; done; }
    local i; for ((i = 0; i < jl; i++)); do worker local & done
    for ((i = 0; i < rl; i++)); do worker remote & done
    wait
    echo "c2c cpu: $# file(s): $(grep -c local "$q/done" 2>/dev/null || echo 0) on this node ($jl cores), $(grep -c remote "$q/done" 2>/dev/null || echo 0) on the peer ($rl cores)"
    rm -rf "$q"
}

# ---------------------------------------------------------------- bench
cmd_bench() {
    case "${1:-link}" in
        link)
            echo "link (c2cd, TCP over c2c0):"; "$BIN/c2cctl" status 2>/dev/null | grep -E "latency|traffic"
            echo "remote GPU data path:"; cmd_gpu bench -m 128 ;;
        *) die "usage: c2c bench link" ;;
    esac
}

case "${1:-}" in
    status) shift; cmd_status "$@" ;;
    doctor) shift; cmd_doctor "$@" ;;
    config) shift; cmd_config "$@" ;;
    gpu)    shift; cmd_gpu "$@" ;;
    ram)    shift; cmd_ram "$@" ;;
    cpu)    shift; cmd_cpu "$@" ;;
    bench)  shift; cmd_bench "$@" ;;
    setup)  shift; exec "$SRC/setup.sh" "$@" ;;
    version) echo "usbc-c2c $(cat "$SRC/VERSION" 2>/dev/null || echo dev)" ;;
    *) sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
